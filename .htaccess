<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /smartedu-admin/
  
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /smartedu-admin/index.html [L]
</IfModule>

# 如果需要处理 /login 这种路径（不带 /smartedu-admin 前缀）
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>